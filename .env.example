# Copy to .env.local for local development. Names only: never commit values.
# None of these may use the NEXT_PUBLIC_ prefix. See CLAUDE.md section 9
# and docs/CHATBOT_SETUP.md section 5.

# Chat kill switch and mock mode ("true" or "false")
CHAT_ENABLED=
CHAT_MOCK=

# n8n webhook (server-only)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Upstash Redis for rate limiting (server-only, added by the Vercel integration)
# Vercel's Upstash integration adds KV_REST_API_URL / KV_REST_API_TOKEN (or
# UPSTASH_KV_REST_API_URL / UPSTASH_KV_REST_API_TOKEN) instead; any pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical origin for metadata, sitemap and JSON-LD (e.g. https://example.com).
# Not secret. Falls back to the Vercel production URL.
SITE_URL=
